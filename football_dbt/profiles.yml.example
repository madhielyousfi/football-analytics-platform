# Copy to profiles.yml if you want a custom local profile.
# The committed profiles.yml uses the same local, credential-free database path.
football_analytics:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: "{{ env_var('DBT_DUCKDB_PATH', '../data/football.duckdb') }}"
      schema: main
      threads: 1
